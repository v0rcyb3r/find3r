# Evidence-store encryption passphrase (derives the Fernet key). Leave unset to
# run the store in plaintext (dev only). Required for any real target data.
NEESHA_STORE_KEY=change-me-to-a-long-random-passphrase

# Key used to HMAC-sign preflight.json. Change this for shared deployments.
NEESHA_PREFLIGHT_KEY=change-me

# Postgres password for the optional team/cloud mode (docker-compose "team" profile).
NEESHA_PG_PASSWORD=change-me

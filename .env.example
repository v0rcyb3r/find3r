# Evidence-store encryption passphrase. Required: the store refuses to open
# unencrypted unless NEESHA_ALLOW_PLAINTEXT=1 is set explicitly, which is for
# throwaway local experiments only. There is no recovery path if this is lost.
NEESHA_STORE_KEY=

# HMAC key for signing preflight.json. No default: a key committed in the
# source would let anyone forge an authorization.
#   openssl rand -base64 32
NEESHA_PREFLIGHT_KEY=

# Database. Postgres is the deployment target; SQLite is fine for local work
# and is what the test suite uses.
#   postgresql+psycopg://neesha:<password>@localhost:5432/neesha
NEESHA_DATABASE_URL=sqlite:///./data/neesha.sqlite3
NEESHA_PG_PASSWORD=

# --- source credentials, all optional ---------------------------------------
# Tier B, metered. Spend is not capped until the ledger lands.
HUNTER_API_KEY=
SHODAN_API_KEY=
HIBP_API_KEY=
# Tier A but keyed.
URLSCAN_API_KEY=
GITHUB_TOKEN=
CENSYS_API_ID=
CENSYS_API_SECRET=
# Google Programmable Search, for dorking. Metered: scraping the HTML SERP
# violates Google's terms and gets the host IP banned, so the API is the only
# supported path.
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# Optional runtime analysis. These are separate from coding-assistant credentials.
# Explicit model IDs must be set from your provider account. No model calls run by default.
OPENAI_API_KEY=
NEESHA_OPENAI_MODEL=
NEESHA_OPENAI_CALL_CAP_USD=
ANTHROPIC_API_KEY=
NEESHA_ANTHROPIC_MODEL=
NEESHA_ANTHROPIC_CALL_CAP_USD=
GEMINI_API_KEY=
NEESHA_GOOGLE_MODEL=
NEESHA_GOOGLE_CALL_CAP_USD=
DEEPSEEK_API_KEY=
NEESHA_DEEPSEEK_MODEL=
NEESHA_DEEPSEEK_CALL_CAP_USD=

# Conservative whole-search estimates covering requested results; no guessed live prices.
HUNTER_ESTIMATED_USD_PER_SEARCH=
INTELX_API_KEY=
INTELX_ESTIMATED_USD_PER_SEARCH=
# DeHashed stays unavailable until its current official contract is verified.
# Optional email metadata: vendor currently accepts existing keys only; no new keys.
EMAILREP_API_KEY=
